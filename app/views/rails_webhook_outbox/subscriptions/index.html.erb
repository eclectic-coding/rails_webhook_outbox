<div class="rwo-header rwo-header-row">
  <h1>Subscriptions</h1>
  <%= link_to "New Subscription", new_subscription_path, class: "rwo-btn" %>
</div>

<% if @subscriptions.empty? %>
  <p class="rwo-empty">No subscriptions yet.</p>
<% else %>
  <table class="rwo-table">
    <thead>
      <tr>
        <th>URL</th>
        <th>Events</th>
        <th>Status</th>
        <th>Failures</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "rails_webhook_outbox/subscriptions/subscription", collection: @subscriptions %>
    </tbody>
  </table>
<% end %>
