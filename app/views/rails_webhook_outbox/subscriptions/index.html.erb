<div class="rwo-header rwo-header-row">
  <h1>Subscriptions</h1>
  <%= link_to "New Subscription", new_subscription_path, class: "rwo-btn" %>
</div>

<% if @subscriptions.empty? %>
  <p class="rwo-empty">No subscriptions yet.</p>
<% else %>
  <table class="rwo-table">
    <thead>
      <tr>
        <th>URL</th>
        <th>Events</th>
        <th>Status</th>
        <th>Failures</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @subscriptions.each do |subscription| %>
        <tr>
          <td><%= link_to subscription.url, subscription_path(subscription), class: "rwo-path" %></td>
          <td class="rwo-muted"><%= subscription.events.join(", ") %></td>
          <td><%= active_badge(subscription.active?) %></td>
          <td class="rwo-muted"><%= subscription.consecutive_failures %></td>
          <td>
            <%= button_to(subscription.active? ? "Disable" : "Enable",
                  subscription_path(subscription),
                  method: :patch,
                  params: { subscription: { active: !subscription.active? } },
                  class: "rwo-btn-small") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
